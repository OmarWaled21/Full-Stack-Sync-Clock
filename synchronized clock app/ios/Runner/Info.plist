<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Basic App Information -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Synchronized Clock</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>synchronized_clock</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>

    <!-- App Launch Settings -->
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>

    <!-- Supported Orientations -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- App Permissions and Features -->
    <!-- Location Permissions -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Your app needs access to your location to provide location-based features.</string>
    <key>NSLocationAlwaysUsageDescription</key>
    <string>Your app needs access to your location for continuous location tracking.</string>

    <!-- Bluetooth Permissions -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Your app needs Bluetooth to connect to nearby devices.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>Your app needs Bluetooth to communicate with nearby Bluetooth peripherals.</string>

    <!-- Internet & HTTP Traffic Permissions (App Transport Security) -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/> <!-- Allow non-secure HTTP requests -->
    </dict>

    <!-- Background Modes (for Location, Bluetooth, etc.) -->
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string> <!-- For background location updates -->
        <string>bluetooth-central</string> <!-- For Bluetooth operations in the background -->
        <string>bluetooth-peripheral</string> <!-- For BLE peripherals -->
    </array>

    <!-- Required Device Capabilities -->
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>bluetooth-le</string> <!-- Bluetooth Low Energy support -->
        <string>location-services</string> <!-- Location services -->
    </array>

    <!-- Queries for External Intent Actions (SMS, Tel, etc.) -->
    <key>UISupportedExternalAccessoryProtocols</key>
    <array>
        <string>com.example.bluetoothDevice</string> <!-- If specific Bluetooth protocol is used -->
    </array>

    <!-- Support for SMS, Tel, and Browser actions -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>sms</string>
        <string>tel</string>
        <string>http</string>
    </array>
	
</dict>
</plist>
